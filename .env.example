# NAQLA — local development environment
# Generated from packages/config/src/index.ts (ENV_SPEC). Edit the spec, not this file.
# Copy to .env.local and fill in. Never commit a filled-in copy.

# ── shared ──
# Runtime mode.
NODE_ENV=development

# Deployment: development (local), staging (private trial, synthetic data, invited testers only) or production (future launch). REQUIRED when NODE_ENV=production. Staging gets every infrastructure protection of production (real storage, CORS, budgets) but keeps the labelled pilot content and test doubles; untrusted code never runs on it.
# optional: NAQLA_ENV=development

# The region this deployment stores data in. Required because D-004 makes data residency a documented decision, and an unnamed region cannot be documented.
NAQLA_DEPLOY_REGION=unset-pending-OPEN-022

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key. Public by design: it is only safe because RLS denies by default. If RLS is ever disabled on a table, this key becomes a data leak.
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key

# Structured log level.
# optional: LOG_LEVEL=info

# ── web ──
# Public origin of the Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin of the NestJS API the web app talks to.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── api ──
# Staging only: comma-separated e-mail addresses (or @domain suffixes) allowed to use the API. Everyone else is refused even with a valid session. REQUIRED when NAQLA_ENV=staging.
# optional: STAGING_ALLOWED_EMAILS=owner@example.org,@testers.example.org

# Staging only, data CLI: the owner decision id (D-nnn) that allows publishing the labelled DEMO pilot in the private staging database. Unset: refused (D-136 is local-only by default). Refused in production.
# optional: PILOT_STAGING_DECISION=

# Requests per minute per client (IP + user) before 429. Unset outside production/staging: no limit (tests). Default 120 when NODE_ENV=production.
# optional: RATE_LIMIT_PER_MINUTE=120

# Service role key. BYPASSES RLS. API only — never sent to the browser, never in a NEXT_PUBLIC_ variable, and used only in paths that do their own authorisation.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# Postgres connection string for migrations and the job queue.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Port for the NestJS API. Defaults to 3001.
# optional: API_PORT=3001

# Queue implementation. Postgres-backed by decision, kept swappable on purpose.
# optional: JOB_QUEUE_DRIVER=postgres

# Prefix for Supabase Storage buckets, so environments cannot collide.
# optional: STORAGE_BUCKET_PREFIX=dev

# The Supabase project JWT secret. The API verifies every access token signature with it.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
SUPABASE_JWT_SECRET=local-jwt-secret-change-me

# Optional. The project's public signing keys (https://<project>.supabase.co/auth/v1/.well-known/jwks.json). When set, tokens signed with asymmetric keys (ES256/RS256) are verified against it; HS256 tokens still use SUPABASE_JWT_SECRET.
# optional: SUPABASE_JWKS_URL=

# supabase (default) or memory. memory is refused when NODE_ENV=production.
# optional: STORAGE_DRIVER=supabase

# Maximum accepted upload size in bytes. Defaults to 10 MiB.
# optional: UPLOAD_MAX_BYTES=10485760

# Agent provider. Only local-test exists (TEST/NON-PRODUCTION); refused when NODE_ENV=production. A real provider arrives after OPEN-023.
# optional: AGENT_PROVIDER=local-test

# Per-user daily cap on agent invocations. Development default 50. REQUIRED in production: the real value is TBD until a provider is connected and cost is measured (D-073).
# optional: AGENT_BUDGET_CALLS_PER_DAY=50

# Comma-separated browser origins allowed to call the API (e.g. the app URL). REQUIRED in production, where "*" is refused. Unset outside production: any origin (development only). S0, backlog P0-3.
# optional: CORS_ALLOWED_ORIGINS=http://localhost:3000

# off (default) or internal. internal shows UNVERIFIED candidate learning resources, labelled and audited, to internal testers in a development deployment that shows demo content. Refused when NODE_ENV=production (Phase B, PO decision 2).
# optional: LEARNING_CANDIDATE_PREVIEW=off

# off (default) or simulated. simulated is an in-memory TEST double of the GitHub App integration with synthetic repositories; no GitHub request is ever made. Refused when NODE_ENV=production. A real GitHub App arrives only after the owner approves the design (Phase C round 2, item 1).
# optional: GITHUB_MODE=off

# GITHUB_MODE=app: the numeric App ID (staging App only until production is approved).
# optional: GITHUB_APP_ID=

# GITHUB_MODE=app: the App slug used for the install link https://github.com/apps/<slug>/installations/new.
# optional: GITHUB_APP_SLUG=

# GITHUB_MODE=app: the App client ID (user authorization during install).
# optional: GITHUB_APP_CLIENT_ID=

# GITHUB_MODE=app: the App client secret. Hosting secret store only.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
# optional: GITHUB_APP_CLIENT_SECRET=

# GITHUB_MODE=app: the App private key (PEM; \n-escaped newlines accepted). Hosting secret store only; rotate on any doubt.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
# optional: GITHUB_APP_PRIVATE_KEY=

# GITHUB_MODE=app: ≥ 32 random characters signing the install state (CSRF protection of the install callback).
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
# optional: GITHUB_APP_STATE_SECRET=

# GITHUB_MODE=app: API base URL (default https://api.github.com). Tests point it at a local mock.
# optional: GITHUB_API_BASE=

# Secret that signs GitHub webhook deliveries (X-Hub-Signature-256). Required when GITHUB_MODE is not off; at least 32 characters.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
# optional: GITHUB_WEBHOOK_SECRET=

# off (default), synthetic_dev or recorded. synthetic_dev runs team-written test packs on SYNTHETIC code in the development namespace sandbox (apps/runner), in shadow mode — local development only. recorded serves results recorded earlier by the development runner for the simulated GitHub snapshots (labelled as recorded; no code runs) — for staging. Untrusted code never runs on the API host.
# optional: R2_MODE=off
