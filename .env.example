# NAQLA — local development environment
# Generated from packages/config/src/index.ts (ENV_SPEC). Edit the spec, not this file.
# Copy to .env.local and fill in. Never commit a filled-in copy.

# ── shared ──
# Runtime mode.
NODE_ENV=development

# The region this deployment stores data in. Required because D-004 makes data residency a documented decision, and an unnamed region cannot be documented.
NAQLA_DEPLOY_REGION=unset-pending-OPEN-022

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key. Public by design: it is only safe because RLS denies by default. If RLS is ever disabled on a table, this key becomes a data leak.
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key

# Structured log level.
# optional: LOG_LEVEL=info

# ── web ──
# Public origin of the Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin of the NestJS API the web app talks to.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── api ──
# Service role key. BYPASSES RLS. API only — never sent to the browser, never in a NEXT_PUBLIC_ variable, and used only in paths that do their own authorisation.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# Postgres connection string for migrations and the job queue.
# SECRET: server-side only. Never in a NEXT_PUBLIC_ variable.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Port for the NestJS API. Defaults to 3001.
# optional: API_PORT=3001

# Queue implementation. Postgres-backed by decision, kept swappable on purpose.
# optional: JOB_QUEUE_DRIVER=postgres

# Prefix for Supabase Storage buckets, so environments cannot collide.
# optional: STORAGE_BUCKET_PREFIX=dev
